			<string>%lld file is already small</string>
			<key>other</key>
			<string>%lld files are already small</string>
		</dict>
	</dict>
	<key>%lld döngü</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld cycle</string>
			<key>other</key>
			<string>%lld cycles</string>
		</dict>
	</dict>
